<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="380.0" stylesheets="@/styles/personal_records.css" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.fittrack.fittrack_frontend.controller.PersonalRecordsController">

    <!-- CABEÇALHO -->
    <top>
        <VBox spacing="16.0" style="-fx-background-color: #121212;">
            <padding>
                <Insets top="20.0" right="20.0" left="20.0" bottom="10.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Button text="‹" styleClass="btn-icon-back" onAction="#handleVoltar" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Recordes Pessoais (PRs)" style="-fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox styleClass="btn-icon-badge">
                    <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                        <Image url="@/icons/trophy.png" />
                    </ImageView>
                </HBox>
            </HBox>

            <!-- Filtros por Categoria -->
            <ScrollPane fitToHeight="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="NEVER">
                <content>
                    <HBox spacing="10.0">
                        <Button text="Geral" styleClass="filter-pill-active" />
                        <Button text="Exercício" styleClass="filter-pill" />
                        <Button text="Carga" styleClass="filter-pill" />
                        <Button text="Volume" styleClass="filter-pill" />
                    </HBox>
                </content>
            </ScrollPane>
        </VBox>
    </top>

    <!-- CONTEÚDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="NEVER">
            <content>
                <VBox spacing="18.0" style="-fx-background-color: #121212;">
                    <padding>
                        <Insets top="10.0" right="20.0" bottom="24.0" left="20.0"/>
                    </padding>

                    <!-- CARD HERO: Maior Carga da História -->
                    <VBox styleClass="hero-card" spacing="8.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <Image url="@/icons/trophy-large.png" />
                            </ImageView>
                            <Label text="Maior Carga da História" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        </HBox>
                        
                        <Label text="AGACHAMENTO LIVRE" styleClass="hero-subtitle" />
                        <Label text="180 kg" styleClass="hero-value" />
                        <Label text="Alcançado em 15 Out 2025" style="-fx-text-fill: #777777; -fx-font-size: 12px;" />
                    </VBox>

                    <!-- GRID DE METRICAS RÁPIDAS (2x2) -->
                    <GridPane hgap="12.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" />
                            <ColumnConstraints percentWidth="50.0" />
                        </columnConstraints>
                        <children>
                            <!-- Card 1: Carga Absoluta -->
                            <VBox styleClass="metric-card" spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT">
                                    <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                        <Image url="@/icons/Frame.png" />
                                    </ImageView>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="PR" styleClass="badge-pr-tag" />
                                </HBox>
                                <Label text="180 kg" styleClass="metric-value" />
                                <Label text="Maior Carga Absoluta" styleClass="metric-label" wrapText="true" />
                            </VBox>

                            <!-- Card 2: Volume em Treino -->
                            <VBox styleClass="metric-card" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT">
                                    <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                        <Image url="@/icons/trophy.png" />
                                    </ImageView>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="PR" styleClass="badge-pr-tag" />
                                </HBox>
                                <Label text="12.450 kg" styleClass="metric-value" />
                                <Label text="Maior Volume em Treino" styleClass="metric-label" wrapText="true" />
                            </VBox>

                            <!-- Card 3: Reps sob Carga -->
                            <VBox styleClass="metric-card" spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT">
                                    <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                        <Image url="@/icons/repeat.png" />
                                    </ImageView>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="PR" styleClass="badge-pr-tag" />
                                </HBox>
                                <Label text="100 kg × 15" styleClass="metric-value" />
                                <Label text="Maior Reps sob Carga" styleClass="metric-label" wrapText="true" />
                            </VBox>

                            <!-- Card 4: Frequência Semanal -->
                            <VBox styleClass="metric-card" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT">
                                    <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                        <Image url="@/icons/calendar.png" />
                                    </ImageView>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="PR" styleClass="badge-pr-tag" />
                                </HBox>
                                <Label text="8 semanas" styleClass="metric-value" />
                                <Label text="Maior Frequência Semanal" styleClass="metric-label" wrapText="true" />
                            </VBox>
                        </children>
                    </GridPane>

                    <!-- SEÇÃO: PRs por Exercício -->
                    <VBox spacing="12.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="PRs por Exercício" style="-fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Ver todos" styleClass="section-link" />
                        </HBox>

                        <VBox fx:id="containerPRsExercício" spacing="10.0" />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
