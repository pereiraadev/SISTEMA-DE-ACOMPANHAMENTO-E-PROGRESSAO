<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="380.0" stylesheets="@/styles/metrics_hub.css" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.fittrack.fittrack_frontend.controller.GroupDetailController">

    <!-- CABEÇALHO -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #121212;">
            <padding>
                <Insets top="20.0" right="20.0" left="20.0" bottom="10.0"/>
            </padding>
            <Button text="‹" styleClass="btn-icon-back" onAction="#handleVoltar" />
            <VBox spacing="2.0">
                <Label fx:id="lblNomeGrupo" text="—" style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" />
                <Label text="Grupo Muscular" style="-fx-text-fill: #888888; -fx-font-size: 12px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox styleClass="badge-vol-positive" alignment="CENTER">
                <Label fx:id="lblTagFoco" text="—" style="-fx-text-fill: #43D61B; -fx-font-weight: bold; -fx-font-size: 12px;" />
            </HBox>
        </HBox>
    </top>

    <!-- CONTEÚDO SCROLLABLE -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="NEVER">
            <content>
                <VBox spacing="18.0" style="-fx-background-color: #121212;">
                    <padding>
                        <Insets top="10.0" right="20.0" bottom="24.0" left="20.0"/>
                    </padding>

                    <!-- CARD 1: DISTRIBUIÇÃO DE VOLUME -->
                    <VBox styleClass="metric-card-row" spacing="14.0">
                        <Label text="Distribuição de Volume" styleClass="card-title" />

                        <HBox alignment="CENTER">
                            <StackPane prefWidth="180.0" prefHeight="180.0">
                                <!-- PieChart centralizado para criar a rosca -->
                                <PieChart fx:id="chartVolume" legendVisible="false" labelsVisible="false" prefWidth="180.0" prefHeight="180.0" />
                                
                                <!-- Círculo interno para cortar o meio (efeito Donut) -->
                                <Region styleClass="donut-hole" maxWidth="110.0" maxHeight="110.0" />

                                <VBox alignment="CENTER" spacing="0.0">
                                    <Label fx:id="lblVolumeTotalFormatado" text="—" styleClass="donut-center-title" />
                                    <Label text="kg total" styleClass="donut-center-subtitle" />
                                </VBox>
                            </StackPane>
                        </HBox>

                        <!-- Legendas dinamicas geradas pelo Controller -->
                        <GridPane fx:id="gridLegenda" hgap="12.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" />
                                <ColumnConstraints percentWidth="50.0" />
                            </columnConstraints>
                        </GridPane>
                    </VBox>

                    <!-- CARD 2: FREQUÊNCIA MENSAL -->
                    <VBox styleClass="metric-card-row" spacing="16.0">
                        <Label text="Frequência Mensal" styleClass="card-title" />
                        <HBox fx:id="containerBarrasFrequencia" alignment="BOTTOM_CENTER" spacing="28.0" prefHeight="130.0" />
                    </VBox>

                    <!-- CARDS DE KPI INFERIORES -->
                    <GridPane hgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" />
                            <ColumnConstraints percentWidth="50.0" />
                        </columnConstraints>
                        <children>
                            <VBox styleClass="stat-kpi-card" spacing="4.0" GridPane.columnIndex="0">
                                <Label text="Total de treinos" styleClass="card-subtitle" />
                                <Label fx:id="lblTotalTreinos" text="—" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold;" />
                            </VBox>

                            <VBox styleClass="stat-kpi-card" spacing="4.0" GridPane.columnIndex="1">
                                <Label text="Média semanal" styleClass="card-subtitle" />
                                <Label fx:id="lblMediaSemanal" text="—" style="-fx-text-fill: #43D61B; -fx-font-size: 18px; -fx-font-weight: bold;" />
                            </VBox>
                        </children>
                    </GridPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
