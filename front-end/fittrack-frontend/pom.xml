<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <!-- Declara a versão do modelo de objeto de projeto (POM) usada pelo Maven -->
    <modelVersion>4.0.0</modelVersion>
    
    <!-- PARENT: Configurações herdadas do Spring Boot Starter Parent        -->
    <!-- Define as versões padrão e compatíveis de plugins e dependências.   -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version> <!-- Versão estável (LTS) do Spring Boot -->
        <relativePath/> <!-- Busca a versão diretamente do repositório central do Maven -->
    </parent>

    <!-- IDENTIFICAÇÃO DO PROJETO -->
    <groupId>com.fittrack</groupId> <!-- Pacote raiz e organização do projeto -->
    <artifactId>fittrack-frontend</artifactId> <!-- Nome do módulo / artefato compilado -->
    <version>0.0.1-SNAPSHOT</version> <!-- Versão atual de desenvolvimento do projeto -->
    <name>fittrack-frontend</name> <!-- Nome de exibição do projeto -->
    <description>Front-end em JavaFX com Spring Boot para o FitTrack</description> <!-- Descrição do módulo -->

    <!-- PROPRIEDADES: Variáveis globais reutilizáveis no pom.xml -->
    <properties>
        <java.version>21</java.version> <!-- Define a versão do JDK (Java 21) -->
        <javafx.version>21.0.1</javafx.version> <!-- Versão das bibliotecas do OpenJFX -->
    </properties>

    <!-- DEPENDÊNCIAS: Bibliotecas externas utilizadas no projeto -->
    <dependencies>

        <!-- Núcleo do Spring Boot (gerenciamento de beans e injeção de dependências) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JavaFX Controls: Componentes de interface gráfica (Botões, Tabelas, Campos de Texto) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX FXML: Suporte para carregar telas em XML desenhadas no Scene Builder -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Spring Boot DevTools: Utilitários e suporte a recarregamento em desenvolvimento -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Starter Test: Suporte a testes unitários e de integração (JUnit, Mockito) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- BUILD: Plugins de compilação e empacotamento do projeto -->
    <build>
        <plugins>

            <!-- Plugin do Spring Boot para empacotar o projeto em um .jar executável -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
