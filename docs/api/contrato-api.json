{
  "descricao": "Contrato da API do backend. Tudo responde em json e os erros sempre voltam como {\"erro\": \"mensagem\"}",
  "autenticacao": "todas as rotas /api exigem o header Authorization: Bearer <token>. O token vem do /auth/login",
  "endpoints": [
    {
      "nome": "Cadastro",
      "metodo": "POST",
      "url": "/auth/cadastrar",
      "headers": {
        "Content-Type": "application/json"
      },
      "corpo": {
        "nome": "Ana Souza",
        "email": "ana@email.com",
        "senha": "segredo1"
      },
      "regras": "nome obrigatorio (ate 120), email valido (ate 254), senha de 6 a 72 caracteres",
      "sucesso": {
        "status": 201,
        "corpo": {
          "id": 1,
          "nome": "Ana Souza",
          "email": "ana@email.com"
        }
      },
      "erros": [
        {
          "status": 400,
          "corpo": {
            "erro": "E-mail inválido."
          }
        },
        {
          "status": 409,
          "corpo": {
            "erro": "E-mail já cadastrado."
          }
        }
      ]
    },
    {
      "nome": "Login",
      "metodo": "POST",
      "url": "/auth/login",
      "headers": {
        "Content-Type": "application/json"
      },
      "corpo": {
        "email": "ana@email.com",
        "senha": "segredo1"
      },
      "sucesso": {
        "status": 200,
        "corpo": {
          "token": "<jwt>",
          "tipo": "Bearer"
        }
      },
      "erros": [
        {
          "status": 400,
          "corpo": {
            "erro": "A senha é obrigatória."
          }
        },
        {
          "status": 401,
          "corpo": {
            "erro": "E-mail ou senha inválidos."
          }
        }
      ]
    },
    {
      "nome": "Historico de um exercicio ordenado",
      "metodo": "GET",
      "url": "/api/exercicios/{exercicioId}/historico?ordenarPor=carga&direcao=desc",
      "parametros": {
        "ordenarPor": "data, carga, repeticoes ou volume (padrao: data)",
        "direcao": "asc ou desc (padrao: asc)"
      },
      "sucesso": {
        "status": 200,
        "corpo": {
          "exercicioId": 3,
          "ordenarPor": "carga",
          "direcao": "desc",
          "total": 2,
          "registros": [
            {
              "treinoId": 12,
              "dataTreino": "2026-10-15",
              "exercicioId": 3,
              "exercicio": "Supino Reto",
              "numeroSerie": 1,
              "cargaUtilizada": 82.5,
              "repeticoesRealizadas": 6,
              "volumeCalculado": 495.0
            },
            {
              "treinoId": 10,
              "dataTreino": "2026-10-01",
              "exercicioId": 3,
              "exercicio": "Supino Reto",
              "numeroSerie": 1,
              "cargaUtilizada": 80.0,
              "repeticoesRealizadas": 8,
              "volumeCalculado": 640.0
            }
          ]
        }
      },
      "observacao": "se o exercicio nao tem registros volta 200 com total 0 e registros []",
      "erros": [
        {
          "status": 400,
          "corpo": {
            "erro": "ordenarPor inválido. Use: data, carga, repeticoes ou volume."
          }
        }
      ]
    },
    {
      "nome": "Comparativo com a sessao anterior",
      "metodo": "GET",
      "url": "/api/treinos/{id}/comparativo/{exercicioId}",
      "descricao": "compara o exercicio no treino {id} com a sessao anterior que tambem fez esse exercicio. Se o treino ainda esta em andamento, compara com o ultimo treino concluido. A comparacao usa a classe ComparativoDesempenho (melhor serie de cada treino)",
      "sucesso": {
        "status": 200,
        "corpo": {
          "treinoId": 12,
          "exercicioId": 3,
          "exercicio": "Supino Reto",
          "resultado": "AUMENTO_CARGA",
          "atual": {
            "treinoId": 12,
            "dataTreino": "2026-10-15",
            "maiorCarga": 82.5,
            "totalRepeticoes": 24,
            "totalSeries": 3,
            "volumeTotal": 1980.0
          },
          "anterior": {
            "treinoId": 10,
            "dataTreino": "2026-10-01",
            "maiorCarga": 80.0,
            "totalRepeticoes": 24,
            "totalSeries": 3,
            "volumeTotal": 1920.0
          },
          "diferencaVolume": 60.0
        }
      },
      "observacoes": [
        "resultado pode ser AUMENTO_CARGA, REDUCAO_CARGA, AUMENTO_REPETICOES, REDUCAO_REPETICOES, MANUTENCAO ou SEM_DADOS",
        "AUMENTO_REPETICOES quer dizer que a carga ficou igual e as repeticoes subiram",
        "na primeira vez que o exercicio aparece o resultado e SEM_DADOS e anterior e diferencaVolume vem null"
      ],
      "erros": [
        {
          "status": 400,
          "corpo": {
            "erro": "Treino modelo não tem execução para comparar."
          }
        },
        {
          "status": 404,
          "corpo": {
            "erro": "Treino não encontrado."
          }
        },
        {
          "status": 404,
          "corpo": {
            "erro": "Esse exercício não faz parte do treino."
          }
        }
      ]
    },
    {
      "nome": "Dashboard",
      "metodo": "GET",
      "url": "/api/praticantes/dashboard",
      "sucesso": {
        "status": 200,
        "corpo": {
          "kpis": {
            "totalTreinos": 4,
            "totalExercicios": 2,
            "totalSeries": 5,
            "volumeAcumulado": 3120.0,
            "treinosNaSemana": 2,
            "treinosNoMes": 4,
            "maiorFrequenciaSemanal": 2
          },
          "gruposMusculares": [
            {
              "grupoMuscular": "PEITO",
              "execucoes": 3,
              "series": 4,
              "volume": 2620.0
            },
            {
              "grupoMuscular": "PERNAS",
              "execucoes": 1,
              "series": 1,
              "volume": 500.0
            }
          ],
          "exerciciosMaisRealizados": [
            {
              "exercicioId": 1,
              "exercicio": "Supino",
              "sessoes": 3
            }
          ],
          "estagnacao": [
            {
              "exercicioId": 1,
              "exercicio": "Supino",
              "sessoes": 3,
              "cargaInicial": 80.0,
              "cargaAtual": 80.0,
              "tendencia": "MANUTENCAO",
