      },
      "observacoes": [
        "gruposMusculares vem do maior volume pro menor",
        "exerciciosMaisRealizados traz no maximo 5",
        "estagnacao so inclui exercicios com 3 sessoes ou mais, os estagnados vem primeiro",
        "estagnado = nas ultimas 3 sessoes nem a carga nem o volume passaram da primeira delas",
        "a semana comeca na segunda-feira",
        "tendencia usa o mesmo texto do comparativo: AUMENTO_CARGA, REDUCAO_CARGA ou MANUTENCAO"
      ]
    }
  ],
  "errosGerais": [
    {
      "status": 401,
      "quando": "sem token, token invalido ou expirado (precisa ligar o RespostaJsonSeguranca no SecurityConfig pra vir em json)",
      "corpo": {
        "erro": "Não autenticado. Envie o header Authorization: Bearer <token>."
      }
    },
    {
      "status": 404,
      "quando": "o praticante do token nao existe mais",
      "corpo": {
        "erro": "Praticante não encontrado."
      }
    },
    {
      "status": 500,
      "quando": "erro inesperado no servidor",
      "corpo": {
        "erro": "Erro interno. Tente novamente mais tarde."
      }
    }
  ]
}